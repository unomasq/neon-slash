{
  "name": "proj2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "postinstall": "node -e \"const f=require('fs');f.mkdirSync('public/mediapipe',{recursive:true});f.cpSync('node_modules/@mediapipe/tasks-vision/wasm','public/mediapipe/wasm',{recursive:true});f.mkdirSync('public/tfjs-wasm',{recursive:true});const d='node_modules/@tensorflow/tfjs-backend-wasm/dist/';for(const n of f.readdirSync(d))if(n.endsWith('.wasm'))f.copyFileSync(d+n,'public/tfjs-wasm/'+n)\""
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "@tensorflow-models/pose-detection": "^2.1.3",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "three": "^0.187.0",
    "tone": "^15.1.22"
  }
}
